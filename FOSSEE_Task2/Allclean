#!/bin/bash
echo "Cleaning all Task 2 simulation cases..."
CASES=("Case1_77C" "Case2_127C" "Case3_177C")
for c in "${CASES[@]}"; do
    cd "$c"
    rm -rf [1-9]* [0-9]*[0-9] log.* constant/polyMesh
    cd ..
done
cd grid_independence
for c in "${CASES[@]}"; do
    for m in "coarse" "fine"; do
        cd "${c}_${m}"
        rm -rf [1-9]* [0-9]*[0-9] log.* constant/polyMesh
        cd ..
    done
done
cd ..
echo "Cleanup completed!"
